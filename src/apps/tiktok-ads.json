{
  "slug": "tiktok-ads",
  "name": "TikTok Ads",
  "description": "TikTok Marketing API v1.3 — manage advertiser accounts, campaigns, ad groups, ads, audiences, and pull performance reports for TikTok Ads Manager",
  "logo": "https://www.google.com/s2/favicons?domain=ads.tiktok.com&sz=128",
  "categories": [
    "advertising",
    "marketing",
    "campaigns",
    "social-ads",
    "tiktok",
    "video-ads"
  ],
  "base_url": "https://business-api.tiktok.com/open_api/v1.3",
  "auth": {
    "types": [
      "oauth2"
    ],
    "headers": {
      "Access-Token": "{{token}}"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "access_token",
        "description": "TikTok Marketing API access_token (long-lived). Filled in by OAuth; paste one only when connecting without OAuth.",
        "type": "password"
      },
      {
        "name": "advertiser_id",
        "label": "Advertiser ID",
        "description": "Default advertiser_id used when a tool input omits one. Find via list_advertisers."
      }
    ],
    "oauth2": {
      "authorize_url": "https://business-api.tiktok.com/portal/auth",
      "token_url": "https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/",
      "scopes": [],
      "client_id_required": true,
      "client_secret_required": true,
      "pkce": false,
      "client_id_param_name": "app_id",
      "token_request": {
        "body_format": "json",
        "fields": {
          "app_id": "{{client_id}}",
          "secret": "{{client_secret}}",
          "auth_code": "{{code}}"
        }
      },
      "token_response_path": "data",
      "token_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          0
        ],
        "message_path": "message"
      }
    }
  },
  "tools": [
    {
      "name": "list_advertisers",
      "description": "List advertiser accounts the authorized user has access to. Returns advertiser_id values needed for every other tool. Sends the connection's TikTok app_id and secret, so it needs an OAuth connection.",
      "method": "GET",
      "path": "/oauth2/advertiser/get/?app_id={{credential.client_id}}&secret={{credential.client_secret}}",
      "rate_limit": {
        "min_interval_ms": 100,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          40100
        ]
      },
      "response_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          0
        ],
        "message_path": "message"
      },
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "advertiser_info",
      "description": "Get advertiser account details — timezone, currency, balance, status, industry.",
      "method": "GET",
      "path": "/advertiser/info/",
      "query_param_serialization": {
        "advertiser_ids": "json",
        "fields": "json"
      },
      "rate_limit": {
        "min_interval_ms": 100,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          40100
        ]
      },
      "response_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          0
        ],
        "message_path": "message"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "advertiser_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of advertiser_id strings (max 100)."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional fields to return; defaults to all"
          }
        },
        "required": [
          "advertiser_ids"
        ]
      }
    },
    {
      "name": "campaign_list",
      "description": "List campaigns for an advertiser. Filtering supports status, objective_type, campaign_ids, date range. Use page/page_size for pagination.",
      "method": "GET",
      "path": "/campaign/get/",
      "query_param_serialization": {
        "filtering": "json",
        "fields": "json"
      },
      "rate_limit": {
        "min_interval_ms": 100,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          40100
        ]
      },
      "response_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          0
        ],
        "message_path": "message"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "advertiser_id": {
            "type": "string",
            "description": "Advertiser ID"
          },
          "filtering": {
            "type": "object",
            "description": "Filter object, e.g. {\"campaign_ids\": [\"1234\"], \"primary_status\": \"STATUS_ALL\", \"objective_type\": \"TRAFFIC\"}"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields to return (campaign_id, campaign_name, status, objective_type, budget, etc.)"
          },
          "page": {
            "type": "integer",
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "default": 10,
            "description": "Max 1000"
          }
        },
        "required": [
          "advertiser_id"
        ]
      }
    },
    {
      "name": "campaign_create",
      "description": "Create a campaign. Common objective_type values: TRAFFIC, CONVERSIONS, APP_PROMOTION, REACH, VIDEO_VIEWS, LEAD_GENERATION, ENGAGEMENT, PRODUCT_SALES. budget_mode: BUDGET_MODE_DAY, BUDGET_MODE_TOTAL, BUDGET_MODE_INFINITE. Use BUDGET_MODE_INFINITE to defer budget to ad-group level.",
      "method": "POST",
      "path": "/campaign/create/",
      "rate_limit": {
        "min_interval_ms": 100,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          40100
        ]
      },
      "response_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          0
        ],
        "message_path": "message"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "advertiser_id": {
            "type": "string"
          },
          "campaign_name": {
            "type": "string"
          },
          "objective_type": {
            "type": "string",
            "enum": [
              "TRAFFIC",
              "CONVERSIONS",
              "APP_PROMOTION",
              "REACH",
              "VIDEO_VIEWS",
              "LEAD_GENERATION",
              "ENGAGEMENT",
              "PRODUCT_SALES",
              "WEB_CONVERSIONS"
            ]
          },
          "budget_mode": {
            "type": "string",
            "enum": [
              "BUDGET_MODE_DAY",
              "BUDGET_MODE_TOTAL",
              "BUDGET_MODE_INFINITE"
            ]
          },
          "budget": {
            "type": "number",
            "description": "Required unless budget_mode = BUDGET_MODE_INFINITE"
          },
          "operation_status": {
            "type": "string",
            "enum": [
              "ENABLE",
              "DISABLE"
            ],
            "default": "DISABLE"
          },
          "special_industries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required for regulated verticals (e.g. HOUSING, EMPLOYMENT, CREDIT)"
          }
        },
        "required": [
          "advertiser_id",
          "campaign_name",
          "objective_type",
          "budget_mode"
        ]
      }
    },
