{
  "slug": "vultr",
  "name": "Vultr",
  "description": "MCP server for Vultr Cloud - instances, snapshots, regions, plans",
  "logo": "https://www.google.com/s2/favicons?domain=vultr.com&sz=128",
  "categories": [
    "cloud",
    "servers",
    "vps",
    "infrastructure"
  ],
  "base_url": "https://api.vultr.com/v2",
  "auth": {
    "types": [
      "bearer"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "API Key"
      }
    ]
  },
  "tools": [
    {
      "name": "list_instances",
      "description": "List all instances",
      "method": "GET",
      "path": "/instances",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number"
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_instance",
      "description": "Get instance details",
      "method": "GET",
      "path": "/instances/{instance_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "create_instance",
      "description": "Create a new instance",
      "method": "POST",
      "path": "/instances",
      "input_schema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "os_id": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "sshkey_id": { "type": "array" },
          "hostname": { "type": "string" },
          "user_data": { "type": "string" },
          "enable_ipv6": { "type": "boolean" }
        },
        "required": [
          "region",
          "plan"
        ]
      }
    },
    {
      "name": "delete_instance",
      "description": "Delete an instance",
      "method": "DELETE",
      "path": "/instances/{instance_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "start_instance",
      "description": "Start an instance",
      "method": "POST",
      "path": "/instances/{instance_id}/start",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "stop_instance",
      "description": "Stop an instance",
      "method": "POST",
      "path": "/instances/{instance_id}/halt",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "restart_instance",
      "description": "Restart an instance",
      "method": "POST",
      "path": "/instances/{instance_id}/reboot",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "list_regions",
      "description": "List available regions",
      "method": "GET",
      "path": "/regions",
      "input_schema": {
        "type": "object",
          "properties": { "per_page": { "type": "number" } }
      }
    },
    {
      "name": "list_plans",
      "description": "List available plans",
      "method": "GET",
      "path": "/plans",
      "input_schema": {
        "type": "object",
        "properties": {
            "type": { "type": "string" },
            "per_page": { "type": "number" }
        }
      }
    },
    {
      "name": "list_os",
      "description": "List available OS options",
      "method": "GET",
      "path": "/os",
      "input_schema": {
        "type": "object",
          "properties": { "per_page": { "type": "number" } }
      }
    },
    {
      "name": "list_snapshots",
      "description": "List snapshots",
      "method": "GET",
      "path": "/snapshots",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_snapshot",
      "description": "Create a snapshot",
      "method": "POST",
      "path": "/snapshots",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "name": "block_storage_list",
      "description": "List Vultr block storage subscriptions",
      "method": "GET",
      "path": "/blocks",
      "input_schema": { "type": "object", "properties": { "per_page": { "type": "integer" }, "cursor": { "type": "string" } } }
    },
    {
      "name": "block_storage_get",
      "description": "Get a block storage subscription",
      "method": "GET",
      "path": "/blocks/{block_id}",
      "input_schema": { "type": "object", "properties": { "block_id": { "type": "string" } }, "required": ["block_id"] }
    },
    {
      "name": "block_storage_create",
      "description": "Create a Vultr block storage subscription",
      "method": "POST",
      "path": "/blocks",
      "input_schema": { "type": "object", "properties": { "region": { "type": "string" }, "size_gb": { "type": "integer", "minimum": 10 }, "label": { "type": "string" }, "block_type": { "type": "string", "enum": ["storage_opt", "high_perf"] }, "live": { "type": "boolean" } }, "required": ["region", "size_gb"] }
    },
    {
      "name": "block_storage_update",
      "description": "Rename or expand a block storage subscription",
      "method": "PATCH",
      "path": "/blocks/{block_id}",
      "input_schema": { "type": "object", "properties": { "block_id": { "type": "string" }, "label": { "type": "string" }, "size_gb": { "type": "integer", "description": "New larger size in GiB" } }, "required": ["block_id"] }
    },
    {
      "name": "block_storage_attach",
      "description": "Attach block storage to an instance in the same region",
      "method": "POST",
      "path": "/blocks/{block_id}/attach",
      "input_schema": { "type": "object", "properties": { "block_id": { "type": "string" }, "instance_id": { "type": "string" }, "live": { "type": "boolean" } }, "required": ["block_id", "instance_id"] }
    },
    {
      "name": "block_storage_detach",
      "description": "Detach block storage without deleting it",
      "method": "POST",
      "path": "/blocks/{block_id}/detach",
      "input_schema": { "type": "object", "properties": { "block_id": { "type": "string" }, "live": { "type": "boolean" } }, "required": ["block_id"] }
    },
    {
      "name": "block_storage_delete",
      "description": "Delete a block storage subscription",
      "method": "DELETE",
      "path": "/blocks/{block_id}",
      "input_schema": { "type": "object", "properties": { "block_id": { "type": "string" } }, "required": ["block_id"] }
    }
  ]
}
